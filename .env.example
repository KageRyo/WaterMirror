# Local backend on the same machine:
EXPO_PUBLIC_API_BASE_URL=http://localhost:8001
# Physical phone on the same LAN:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8001
# Remote backend:
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_DEFAULT_MODEL=direct_wqi5
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=10000

# Readiness verifies mounted artifacts; assessments may load a model on first use.
EXPO_PUBLIC_READINESS_TIMEOUT_MS=60000
EXPO_PUBLIC_ASSESSMENT_TIMEOUT_MS=240000
