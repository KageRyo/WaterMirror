{
  "name": "watermirror",
  "version": "2.3.5",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test tests/*.test.cjs",
    "expo:config": "expo config --json",
    "expo:doctor": "expo-doctor",
    "audit:ci": "node scripts/audit.cjs",
    "postinstall": "node scripts/patch-toolchain.cjs --apply"
  },
  "dependencies": {
    "@expo/mcp-tunnel": "0.2.4",
    "@expo/react-native-action-sheet": "^4.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "expo": "~57.0.30",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-notifications": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "i18next": "^23.16.4",
    "intl-pluralrules": "^2.0.1",
    "prop-types": "^15.8.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-i18next": "^15.1.0",
    "react-native": "0.86.3",
    "react-native-chart-kit": "^6.12.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-picker-select": "^9.0.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "babel-preset-expo": "~57.0.16",
    "image-size": "^2.0.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-svg"
      ]
    }
  },
  "overrides": {
    "image-size": "$image-size",
    "uuid": "11.1.1",
    "react-native-picker-select": {
      "@react-native-picker/picker": "$@react-native-picker/picker"
    },
    "zod": "4.6.7",
    "node-forge": "https://codeload.github.com/digitalbazaar/forge/tar.gz/ceba34402e329f0365134f23fe19898756527d65"
  },
  "private": true
}
