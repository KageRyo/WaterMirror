{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "release-apk": {
      "extends": "production",
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "ALLOW_HTTP_BACKEND": "true",
        "EXPO_PUBLIC_REQUEST_TIMEOUT_MS": "10000",
        "EXPO_PUBLIC_READINESS_TIMEOUT_MS": "60000",
        "EXPO_PUBLIC_ASSESSMENT_TIMEOUT_MS": "240000"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
